<% 

Function UrlEncode(Str)
    Dim i, c, ret
    ret = ""
    For i = 1 To Len(Str)
        c = Asc(Mid(Str, i, 1))
        If (c >= 48 And c <= 57) Or (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Then
            ret = ret & Chr(c)
        ElseIf c = 32 Then
            ret = ret & "+"
        Else
            ret = ret & "%" & Right("0" & Hex(c), 2)
        End If
    Next
    UrlEncode = ret
End function

Public Sub Telegram(Message_Text)
sAPI_ID = AFL.Var("TelegramAPI_ID")
sChat_ID = AFL.Var("TelgramCHAT_ID")
sMSG = Message_Text

'URL to open....
sUrl = "https://api.telegram.org/bot" & sAPI_ID & "/sendMessage"
'POST Request to send.
sRequest = "text=" & sMSG & "&chat_id=" & sChat_ID

set oHTTP = CreateObject("Microsoft.XMLHTTP")
oHTTP.open "POST", sUrl,false
oHTTP.setRequestHeader "Content-Type", "application/x-www-form-urlencoded"
oHTTP.setRequestHeader "Content-Length", Len(sRequest)
oHTTP.send sRequest
HTTPPost = oHTTP.responseText

'Store response 
'msgbox(objXmlHttpMain.responseText)
'response.Write (objXmlHttpMain.responseText) 
End Sub 
Public Sub SendMessage(Message_Text)
sMSG = Message_Text

sMyKey = AFL.Var("My_Key")

'URL to open....
sUrl = "https://m1n9ckgf-7291.asse.devtunnels.ms/api/BotSignal/SendMessage"
'POST Request to send.
sRequest = "text=" & UrlEncode(sMSG) & "&key=" & UrlEncode(sMyKey)

set oHTTP = CreateObject("Microsoft.XMLHTTP")
oHTTP.open "POST", sUrl,false
oHTTP.setRequestHeader "Content-Type", "application/x-www-form-urlencoded"
oHTTP.setRequestHeader "Content-Length", Len(sRequest)
oHTTP.send sRequest
HTTPPost = oHTTP.responseText

'Store response 
'msgbox(objXmlHttpMain.responseText)
'response.Write (objXmlHttpMain.responseText) 
End Sub
Public Sub Discord(Message_Text)
    Dim sUrl, sRequest, oHTTP
    On Error Resume Next

    sUrl = "https://discordapp.com/api/webhooks/1463067589696688243/NFSZQP4I5CCFXq0g37ZE6WLCFH1Rr-e8rV7hWh_2iEPgBj3TOl2mgLQ-9fyBiQJrJzo5"
    sRequest = "{""content"":""" & Message_Text & """}"

    Set oHTTP = CreateObject("Microsoft.XMLHTTP")
    oHTTP.Open "POST", sUrl, False
    oHTTP.setRequestHeader "Content-Type", "application/json"
    oHTTP.Send sRequest
End Sub 
